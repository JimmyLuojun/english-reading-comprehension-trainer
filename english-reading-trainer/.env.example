# Copy this file to .env and fill in your real DeepSeek API key.
# .env is ignored by git and must stay local.

OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
TRAINER_MODEL=deepseek-v4-flash
TRAINER_SENTENCE_MODEL=deepseek-v4-pro
TRAINER_PRO_MODEL=deepseek-v4-pro
# Per-request OpenAI-compatible client limits. Values must be positive integers.
TRAINER_LLM_TIMEOUT_SECONDS=45
TRAINER_LLM_MAX_RETRIES=1
